# Copy this file to `.env` in the repo root and fill in real local values.
# Never commit the real `.env` — it's gitignored on purpose.

# --- Django core -------------------------------------------------------

# Which settings module to load. Use coverage_web.settings.local for local
# dev/tests; the PaaS sets coverage_web.settings.production at deploy time.
DJANGO_SETTINGS_MODULE=coverage_web.settings.local

# Cryptographic signing key for sessions/CSRF/password resets. Local dev works
# without this (base.py falls back to an insecure default); production.py
# requires a real value and refuses to boot without one. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changeme-insecure-local-dev-value

# "True" or "False". Verbose error pages + auto static serving when true.
# Never set true in production.
DJANGO_DEBUG=True

# Comma-separated hostnames Django will answer for. Unused in local.py
# (hardcoded to localhost/127.0.0.1 there); required with no default in
# production.py.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production only (read by settings/production.py): scheme-qualified origins
# allowed to POST (admin login, all forms) behind an HTTPS proxy. Comma-sep.
DJANGO_CSRF_TRUSTED_ORIGINS=https://coverage-web.onrender.com

# --- Database ------------------------------------------------------------

# Postgres connection string — no SQLite fallback by design (see
# docs/build-plan.md, "1. Stack": concurrent writers is exactly SQLite's weak
# spot). This placeholder matches the `createdb`/`createuser` commands in
# README.md's local setup section.
DATABASE_URL=postgres://coverage:coverage@localhost:5432/coverage

# --- Auth: Google sign-in (django-allauth) --------------------------------

# OAuth 2.0 client from Google Cloud Console. MUST be configured with
# login-only scopes (openid, email, profile) ONLY — never add a `gmail.*`
# scope to this client (see docs/build-plan.md §3 and the Auth note in the
# build instructions). Creating the actual Cloud Console client is the
# founder's task, not something this scaffold does. The app boots and tests
# pass fine with these placeholders; Google sign-in simply won't complete
# until real values are set.
GOOGLE_OAUTH_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=changeme-google-oauth-client-secret

# --- Auth: optional extra providers (Apple / Microsoft / LinkedIn) --------

# Each provider's sign-in button renders as "Setup Needed" until its
# credentials are filled in, then goes live with no code change. All are
# login-only (identity scopes), same posture as Google. Leave blank to skip.
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_PRIVATE_KEY=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# --- AI features (directory/ai_extract.py) --------------------------------

# Anthropic API key. Blank = every AI code path (LLM deadline extraction, the
# coffee-chat brief, and the "Talk to Coverage" advisor page) is disabled at
# import time — the app boots and every test passes with this unset. Real
# money per API call once set; start with extract_deadlines_ai --dry-run
# --limit 20 to see the cost/impact before a full run.
ANTHROPIC_API_KEY=

# The advisor page (assistant/) has two tiers keyed by accounts.User.plan
# (assistant/plans.py). Free answers on Haiku with a low daily cap; Pro on
# Sonnet with a higher one — the model IS the product difference. The cap
# is a spend ceiling: one message can fan out to several tool round-trips.
ASSISTANT_FREE_MODEL=claude-haiku-4-5-20251001
ASSISTANT_FREE_DAILY_CAP=15
ASSISTANT_PRO_MODEL=claude-sonnet-5
ASSISTANT_PRO_DAILY_CAP=60

# --- Email capture (build-plan.md §5) ------------------------------------

# Shared secret authenticating the inbound-email webhook (Postmark → the app).
# Generated per-environment in production; this placeholder is fine locally.
CAPTURE_INBOUND_SECRET=local-dev-capture-secret

# The domain of each user's capture address (u-<slug>@<domain>). Must match the
# subdomain whose inbound MX points at Postmark.
CAPTURE_INBOUND_DOMAIN=in.coverage.app

# Scheme+host the app is reachable at, for links built outside a request
# (currently just the weekly digest email). Local default matches `runserver`.
SITE_URL=http://localhost:8000

# --- Web Push (deadline alerts) -------------------------------------------

# VAPID keypair identifying this server to the browsers' own push relays —
# genuinely free, no third-party push SaaS involved (RFC 8292). Generate
# once with:
#   python coverage_web/manage.py generate_vapid_keys
# then paste its printed VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY lines here (or
# into the real .env / hosting env vars). Blank = the Settings push toggle
# renders as unavailable and send_deadline_push_alerts no-ops; nothing else
# in the app is affected either way.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address VAPID's "sub" claim requires, no "mailto:" prefix (added
# automatically). Any address the push services could reach if this server's
# traffic ever needed throttling.
VAPID_CLAIM_EMAIL=

# --- Outbound email (production) ------------------------------------------

# Transactional email URL (password resets; later digests/alerts). Example for
# Resend SMTP: smtp+tls://resend:YOUR_API_KEY@smtp.resend.com:587
# Blank/unset in production = mail is printed to the service logs instead of
# sent, so password resets stay recoverable rather than 500ing.
EMAIL_URL=
DEFAULT_FROM_EMAIL=Coverage <no-reply@localhost>

# --- Error monitoring (optional) -----------------------------------------

# Sentry DSN. Blank = disabled (app boots fine without it). Requires the
# sentry-sdk package installed to actually activate.
SENTRY_DSN=

# --- Production-only hardening (read by settings/production.py) ----------

# "True"/"False". Redirect all HTTP requests to HTTPS. Defaults to True in
# production.py even if unset; listed here so it's discoverable.
DJANGO_SECURE_SSL_REDIRECT=True

# Seconds browsers should remember to only use HTTPS for this host (HSTS).
# Defaults to 604800 (7 days) in production.py even if unset.
DJANGO_SECURE_HSTS_SECONDS=604800
